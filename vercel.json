{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*\\.html)", "destination": "/$1" },
    { "source": "/(.*\\.js)", "destination": "/$1" },
    { "source": "/(.*\\.css)", "destination": "/$1" },
    { "source": "/", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/ranking_batch",
      "schedule": "0 15 * * *"
    }
  ]
}
